# Mess Admin Backend Environment Variables
PORT=5002

# SQLite Persistent Volume Path (map to Railway volume, e.g. /data/smartmess.db)
DB_PATH=./data/smartmess.db

# Vercel Frontend URL (comma-separated if multiple, e.g. https://mess.vercel.app)
FRONTEND_URL=http://localhost:5173

# Resend HTTPS API Key
RESEND_API_KEY=
EMAIL_FROM=Smart Mess <onboarding@resend.dev>

# Legacy Email OTP Credentials (optional)
EMAIL_USER=
EMAIL_PASS=
JWT_SECRET=your-jwt-secret-key-here
