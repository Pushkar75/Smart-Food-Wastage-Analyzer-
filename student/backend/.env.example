# Student Backend Environment Variables
PORT=5000

# SQLite Persistent Volume Path (map to Railway volume, e.g. /data/smartmess.db)
DB_PATH=./data/smartmess.db

# Vercel Frontend URL (comma-separated if multiple, e.g. https://student.vercel.app)
FRONTEND_URL=http://localhost:5173

# Email OTP Credentials (optional in demo mode)
EMAIL_USER=
EMAIL_PASS=
JWT_SECRET=your-jwt-secret-key-here
